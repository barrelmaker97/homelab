global_defs {
    enable_script_security
}
{% for check in keepalived_track_scripts %}

vrrp_script {{ check.name }} {
    script "{{ check.path }}"
    interval 3
    timeout 2
    fall 2
    rise 2
    weight -60
    user root
}
{% endfor %}

vrrp_instance VI_1 {
    state {{ keepalived_state }}
    interface {{ keepalived_interface }}
    virtual_router_id {{ keepalived_router_id }}
    priority {{ keepalived_priority }}
    advert_int 1
    unicast_src_ip {{ keepalived_unicast_src_ip }}
    unicast_peer {
{% for peer in keepalived_unicast_peers %}
        {{ peer }}
{% endfor %}
    }
    virtual_ipaddress {
        {{ keepalived_vip }}
    }
    track_script {
{% for check in keepalived_track_scripts %}
        {{ check.name }}
{% endfor %}
    }
}
