# Supported HostKey algorithms by order of preference.
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key

# Restrict key exchange, ciphers and MACs to modern AEAD and ETM algorithms,
# while keeping OpenSSH's default post-quantum key exchanges enabled.
KexAlgorithms -ecdh-sha2-*,diffie-hellman-*
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com

AllowUsers {{ ansible_user }}
PermitRootLogin no

AuthenticationMethods publickey
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no

LoginGraceTime 1m
MaxAuthTries 3

X11Forwarding no
ClientAliveInterval 60
ClientAliveCountMax 10

# Log the key fingerprint used to authenticate.
LogLevel VERBOSE
