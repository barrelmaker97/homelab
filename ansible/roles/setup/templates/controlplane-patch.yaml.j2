cluster:
  etcd:
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381

machine:
  certSANs:
    - "{{ node_hostname }}.{{ local_domain }}"
  network:
    interfaces:
      - interface: "{{ interface_name }}"
        dhcp: true
        vip:
          ip: "{{ cluster_vip }}"
    extraHostEntries:
      - ip: "{{ cluster_vip }}"
        aliases:
          - kube.{{ cluster_domain }}
  time:
      disabled: false
      bootTimeout: 2m0s
      servers:
          - "{{ ntp_server }}"
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: factory.talos.dev/installer/{{ setup_factory_response.json.id }}:v{{ talos_version }}
provisioning:
  diskSelector:
    match: disk.dev_path == "{{ install_disk }}"
  wipe: false
---
# Run workloads on the control plane nodes, which are the only nodes.
apiVersion: v1alpha1
kind: KubeNodeConfig
taints:
  node-role.kubernetes.io/control-plane:
    $patch: delete
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
# Sized from the 7-day p95; the default 512Mi is a third of real use.
resources:
  requests:
    cpu: 200m
    memory: 1536Mi
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
extraArgs:
  bind-address: 0.0.0.0
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
extraArgs:
  bind-address: 0.0.0.0
resources:
  requests:
    cpu: 10m
    memory: 128Mi
---
apiVersion: v1alpha1
kind: KubeProxyConfig
config:
  metricsBindAddress: 0.0.0.0:10249
---
# Longhorn's disk. Talos mounts it at /var/mnt/longhorn and propagates it into
# the kubelet, so it needs no kubelet mount.
apiVersion: v1alpha1
kind: UserVolumeConfig
name: longhorn
provisioning:
  diskSelector:
    match: 'disk.transport == "sata" && !disk.rotational && !system_disk && disk.size > 450u * GB'
  grow: true
  minSize: 450GB
filesystem:
  type: xfs
---
apiVersion: v1alpha1
kind: ExtensionServiceConfig
name: nut-client
configFiles:
  - content: |-
        MONITOR {{ nut_host }} 1 {{ nut_user }} {{ nut_password }} secondary
        SHUTDOWNCMD "/sbin/poweroff"
    mountPath: /usr/local/etc/nut/upsmon.conf
---
apiVersion: v1alpha1
kind: WatchdogTimerConfig
device: /dev/watchdog0
timeout: 2m
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: off
hostname: "{{ node_hostname }}"
---
# talosctl gen config adds the next three as 1.14 defaults. The running nodes
# predate them, so each is pinned to what the nodes do now until it has been
# tested on its own. Workload isolation may cut Longhorn's v1 engine off from
# the host's iscsid.
apiVersion: v1alpha1
kind: SecurityProfileConfig
workloadIsolation: false
---
# /var without nosuid and nodev
apiVersion: v1alpha1
kind: VolumeConfig
name: EPHEMERAL
mount:
  secure: false
---
# Cluster discovery off
apiVersion: v1alpha1
kind: DiscoveryServiceConfig
name: default
$patch: delete
