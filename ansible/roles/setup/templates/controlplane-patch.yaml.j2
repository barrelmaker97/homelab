# etcd and the kubelet use the node's LAN address. Each node also has an IPv6
# ULA, pod network addresses and sometimes the VIP, so selection is pinned.
cluster:
  etcd:
    advertisedSubnets:
      - "{{ node_subnet }}"
      - "!{{ cluster_vip }}/32"
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381

machine:
  certSANs:
    - "{{ node_hostname }}.{{ local_domain }}"
---
apiVersion: v1alpha1
kind: LinkConfig
name: "{{ interface_name }}"
up: true
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: "{{ interface_name }}"
---
# The control plane endpoint, held by one node at a time
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: "{{ cluster_vip }}"
link: "{{ interface_name }}"
---
# Resolves the endpoint without DNS, which runs outside the cluster
apiVersion: v1alpha1
kind: StaticHostConfig
name: "{{ cluster_vip }}"
hostnames:
  - kube.{{ cluster_domain }}
---
apiVersion: v1alpha1
kind: TimeSyncConfig
bootTimeout: 2m0s
ntp:
  servers:
    - "{{ ntp_server }}"
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: factory.talos.dev/installer/{{ setup_factory_response.json.id }}:v{{ talos_version }}
provisioning:
  diskSelector:
    # The only NVMe disk; Longhorn's disk is SATA and its volumes attach as iSCSI
    match: disk.transport == "nvme"
  wipe: false
---
# Run workloads on the control plane nodes, which are the only nodes.
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - "{{ node_subnet }}"
    - "!{{ cluster_vip }}/32"
taints:
  node-role.kubernetes.io/control-plane:
    $patch: delete
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
# Sized from the 7-day p95; the default 512Mi is a third of real use.
resources:
  requests:
    cpu: 200m
    memory: 1536Mi
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
extraArgs:
  bind-address: 0.0.0.0
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
extraArgs:
  bind-address: 0.0.0.0
resources:
  requests:
    cpu: 10m
    memory: 128Mi
---
apiVersion: v1alpha1
kind: KubeProxyConfig
config:
  metricsBindAddress: 0.0.0.0:10249
---
# Longhorn's disk. Talos mounts it at /var/mnt/longhorn and propagates it into
# the kubelet, so it needs no kubelet mount.
apiVersion: v1alpha1
kind: UserVolumeConfig
name: longhorn
provisioning:
  diskSelector:
    match: 'disk.transport == "sata" && !disk.rotational && !system_disk && disk.size > 450u * GB'
  grow: true
  minSize: 450GB
filesystem:
  type: xfs
---
apiVersion: v1alpha1
kind: ExtensionServiceConfig
name: nut-client
configFiles:
  - content: |-
        MONITOR {{ nut_host }} 1 {{ nut_user }} {{ nut_password }} secondary
        SHUTDOWNCMD "/sbin/poweroff"
    mountPath: /usr/local/etc/nut/upsmon.conf
---
apiVersion: v1alpha1
kind: WatchdogTimerConfig
device: /dev/watchdog0
timeout: 2m
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: off
hostname: "{{ node_hostname }}"
